{
  "name": "kagan-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && next dev --webpack --hostname 127.0.0.1",
    "build": "node scripts/prepare-assets.mjs && next build --webpack",
    "preview": "node scripts/serve.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/export.test.mjs",
    "test:browser": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run build && npm test && npm run test:browser"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@tailwindcss/postcss": "4.3.3",
    "lucide-react": "1.60.0",
    "motion": "14.4.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
